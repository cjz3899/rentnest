<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rentnest.tenant.mapper.FeedbackMapper">
    <sql id="feedbackWhere">
        <where>
            <if test="userId != null">AND f.user_id = #{userId}</if>
            <if test="status != null and status != ''">AND f.status = #{status}</if>
        </where>
    </sql>

    <select id="selectPage" parameterType="com.rentnest.tenant.dto.FeedbackQuery"
            resultType="com.rentnest.tenant.dto.FeedbackResp">
        SELECT f.id, f.user_id, f.content, f.problem_desc, f.status, f.reply,
        f.replied_at, f.created_at,
        u.nickname AS user_nickname
        FROM feedback f
        LEFT JOIN users u ON u.id = f.user_id
        <include refid="feedbackWhere"/>
        ORDER BY f.created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countByQuery" parameterType="com.rentnest.tenant.dto.FeedbackQuery" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM feedback f
        <include refid="feedbackWhere"/>
    </select>
</mapper>
