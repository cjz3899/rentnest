<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rentnest.tenant.mapper.RepairTicketMapper">
    <sql id="repairWhere">
        <where>
            <if test="userId != null">AND t.user_id = #{userId}</if>
            <if test="status != null and status != ''">AND t.status = #{status}</if>
        </where>
    </sql>

    <select id="selectPage" parameterType="com.rentnest.tenant.dto.RepairQuery"
            resultType="com.rentnest.tenant.dto.RepairResp">
        SELECT t.id, t.user_id, t.house_id, t.location, t.description, t.contact_phone,
        t.supplement, t.status, t.handler_remark, t.handled_at, t.created_at,
        u.nickname AS user_nickname,
        h.title AS house_title
        FROM repair_ticket t
        LEFT JOIN users u ON u.id = t.user_id
        LEFT JOIN house h ON h.id = t.house_id
        <include refid="repairWhere"/>
        ORDER BY t.created_at DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countByQuery" parameterType="com.rentnest.tenant.dto.RepairQuery" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM repair_ticket t
        <include refid="repairWhere"/>
    </select>
</mapper>
